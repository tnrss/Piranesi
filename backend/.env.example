# Copy this file to backend/.env and fill values for local development.

# Runtime paths. Raspberry Pi setup writes absolute values to
# ~/.config/piranesi/piranesi.env instead of this development file.
# PIRANESI_DATABASE_URL=sqlite:////absolute/path/to/piranesi.db
# PIRANESI_FRONTEND_DIST=/absolute/path/to/frontend/dist
# PIRANESI_SERVE_FRONTEND=0

# Plaid credentials
# Your wording: Plaid user ID + key are supported aliases below.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional aliases (if you prefer these names)
PLAID_USER_ID=
PLAID_KEY=

# Plaid environment
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions
PLAID_REDIRECT_URI=

# Canvas LMS personal API access
# Canvas API URL usually looks like https://school.instructure.com
CANVAS_API_URL=
CANVAS_API_TOKEN=

# App defaults
PIRANESI_TIMEZONE=America/Chicago
DEFAULT_HOURLY_RATE=18
DEFAULT_HOURS_CAP=28
PAYROLL_DEDUCTION_RATE=0.0765

# Optional future integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_API_KEY=
