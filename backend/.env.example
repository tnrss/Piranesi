# Copy this file to backend/.env and fill values for local development.

# Plaid credentials
# Your wording: Plaid user ID + key are supported aliases below.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional aliases (if you prefer these names)
PLAID_USER_ID=
PLAID_KEY=

# Plaid environment
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions

# Public HTTPS URL Plaid can POST webhook events to (e.g. an ngrok tunnel in dev)
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=

# Canvas LMS personal API access
# Canvas API URL usually looks like https://school.instructure.com
CANVAS_API_URL=
CANVAS_API_TOKEN=

# App defaults
DEFAULT_HOURLY_RATE=18
DEFAULT_HOURS_CAP=28
PAYROLL_DEDUCTION_RATE=0.0765

# Optional future integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_API_KEY=
